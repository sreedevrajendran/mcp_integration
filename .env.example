# ==============================================================================
# Antigravity & GitHub Bridge MCP Server Configuration
# ==============================================================================

# GitHub Personal Access Token
# Required for all GitHub tools (get repo, create repo, edit repo, issues, PRs, etc.)
# Classic token: requires 'repo' scope.
# Fine-grained token: requires Read & Write permissions for:
#   - Administration (for editing repo settings)
#   - Contents (for reading/committing files)
#   - Issues (for issue management)
#   - Pull Requests (for PR management)
#   - Metadata (read-only, default)
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_yourPersonalAccessTokenHere

# Local Workspace Directory
# Root directory where your local Antigravity projects reside.
# If omitted, defaults to ~/Documents/Projects or the current directory.
ANTIGRAVITY_PROJECTS_DIR=/home/sreedevrajendran/Documents/Projects
