{
  "name": "mcp_antigravity_with_github_on_gemini",
  "version": "1.0.0",
  "description": "Custom Model Context Protocol (MCP) server bridging Gemini with Antigravity local project workspaces and GitHub",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-antigravity-github": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "agent": "node dist/web/server.js",
    "agent:dev": "tsx src/web/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gemini",
    "antigravity",
    "github"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.26.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@octokit/rest": "^22.0.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
